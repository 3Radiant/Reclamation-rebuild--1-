-- Client entry point. Order matters: camera first, then the character controller
-- (which configures the camera), then everything that builds on them.
local Controllers = script:WaitForChild("Controllers")

local AdminBarController = require(Controllers:WaitForChild("AdminBarController"))
local AnxietyController = require(Controllers:WaitForChild("AnxietyController"))
local ArtilleryController = require(Controllers:WaitForChild("ArtilleryController"))
local ArtilleryEffects = require(Controllers:WaitForChild("ArtilleryEffects"))
local BossBarController = require(Controllers:WaitForChild("BossBarController"))
local CameraController = require(Controllers:WaitForChild("CameraController"))
local ChatController = require(Controllers:WaitForChild("ChatController"))
local CharacterController = require(Controllers:WaitForChild("CharacterController"))
local EffectsController = require(Controllers:WaitForChild("EffectsController"))
local GunController = require(Controllers:WaitForChild("GunController"))
local HudController = require(Controllers:WaitForChild("HudController"))
local MusicController = require(Controllers:WaitForChild("MusicController"))
local MusicUiController = require(Controllers:WaitForChild("MusicUiController"))
local IntroController = require(Controllers:WaitForChild("IntroController"))
local LeaderboardController = require(Controllers:WaitForChild("LeaderboardController"))
local MessageController = require(Controllers:WaitForChild("MessageController"))
local RoundController = require(Controllers:WaitForChild("RoundController"))
local TeamMenuController = require(Controllers:WaitForChild("TeamMenuController"))
local R6Pose = require(script:WaitForChild("Gun"):WaitForChild("R6Pose"))
local ShiftEffects = require(Controllers:WaitForChild("ShiftEffects"))
local ShifterController = require(Controllers:WaitForChild("ShifterController"))
local TitanPoseController = require(Controllers:WaitForChild("TitanPoseController"))
local ThoughtController = require(Controllers:WaitForChild("ThoughtController"))
local YellController = require(Controllers:WaitForChild("YellController"))

CameraController.start()
CharacterController.start()
ThoughtController.start()
GunController.start()
R6Pose.start(function(tool)
	local gun = GunController.getActive()
	return if gun and gun.Tool == tool then gun.Stance else nil
end)
ArtilleryController.start()
ShifterController.start()
TitanPoseController.start()
ChatController.start()
EffectsController.start()
AnxietyController.start()
ShiftEffects.start()
ArtilleryEffects.start()
AdminBarController.start()
BossBarController.start()
MessageController.start()
RoundController.start()
LeaderboardController.start()
TeamMenuController.start()
MusicController.start()
MusicUiController.start()
YellController.start()
IntroController.start()
HudController.start()
