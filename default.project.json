{
  "name": "Reclamation",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Titans": {
        "$path": "assets/titans",
        "$ignoreUnknownInstances": true
      },
      "Guns": {
        "$path": "assets/guns",
        "$ignoreUnknownInstances": true
      },
      "Tools": {
        "$path": "assets/tools",
        "$ignoreUnknownInstances": true
      },
      "Blimps": {
        "$path": "assets/blimps",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "Animate": {
          "$path": "src/character/Animate.client.luau"
        }
      },
      "$properties": {
        "GameSettingsAvatar": "R6",
        "LoadCharacterAppearance": true
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      },
      "Hitboxes": {
        "$className": "Folder"
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}